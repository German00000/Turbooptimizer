<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/state_idle"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="@string/start_stream"
            android:textSize="18sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/stop_stream" />

        <!-- Estado de la transmisión -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_stream"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvConnection" style="@style/Stat.Value" android:text="—" />
                <TextView
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvDevice" style="@style/Stat.Value" android:text="—" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="2"
                    android:useDefaultMargins="false">

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat.Label" android:layout_columnWeight="1" android:text="@string/label_fps" />
                    <TextView
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvFps" style="@style/Stat.Value" android:layout_columnWeight="1" android:text="—" />

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat.Label" android:layout_columnWeight="1" android:text="@string/label_resolution" />
                    <TextView
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvResolution" style="@style/Stat.Value" android:layout_columnWeight="1" android:text="—" />

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat.Label" android:layout_columnWeight="1" android:text="@string/label_bitrate" />
                    <TextView
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvBitrate" style="@style/Stat.Value" android:layout_columnWeight="1" android:text="—" />

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat.Label" android:layout_columnWeight="1" android:text="@string/label_latency" />
                    <TextView
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvLatency" style="@style/Stat.Value" android:layout_columnWeight="1" android:text="—" />

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat.Label" android:layout_columnWeight="1" android:text="@string/label_clients" />
                    <TextView
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvClients" style="@style/Stat.Value" android:layout_columnWeight="1" android:text="0" />

                    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat.Label" android:layout_columnWeight="1" android:text="@string/label_audio" />
                    <TextView
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:id="@+id/tvAudio" style="@style/Stat.Value" android:layout_columnWeight="1" android:text="—" />
                </GridLayout>

                <TextView
                    android:id="@+id/tvWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/warn"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvUrls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyUrl"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copy_urls"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dispositivos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/devices_found"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScan"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_again" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_devices"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiracast"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/miracast_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ajustes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_settings"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat.Label" android:layout_marginTop="12dp" android:text="@string/setting_resolution" />
                <Spinner
                    android:id="@+id/spResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat.Label" android:layout_marginTop="8dp" android:text="@string/setting_fps" />
                <Spinner
                    android:id="@+id/spFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat.Label" android:layout_marginTop="8dp" android:text="@string/setting_bitrate" />
                <Spinner
                    android:id="@+id/spBitrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swLowLatency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setting_low_latency" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_battery_saver" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swReconnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_auto_reconnect" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_internal_audio" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/log_button" />
    </LinearLayout>
</ScrollView>

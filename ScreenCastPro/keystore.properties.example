# Copia este archivo a keystore.properties (no se sube al repositorio) y ajusta los valores.
# Genera la clave con:
#   keytool -genkeypair -v -keystore screencastpro-release.jks -alias screencastpro \
#           -keyalg RSA -keysize 4096 -validity 10000
storeFile=../screencastpro-release.jks
storePassword=CAMBIA_ESTA_CONTRASEÑA
keyAlias=screencastpro
keyPassword=CAMBIA_ESTA_CONTRASEÑA
